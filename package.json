{
  "name": "nhip-dang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "postbuild": "tsx scripts/finalize-build.ts",
    "local": "tsx scripts/run-local.ts",
    "start": "tsx scripts/start.ts",
    "worker": "tsx src/worker.ts",
    "desktop": "tsx scripts/desktop.ts",
    "desktop:bundle": "tsx scripts/build-desktop.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "local:init": "tsx scripts/local.ts init",
    "local:db": "tsx scripts/local.ts start",
    "local:stop": "tsx scripts/local.ts stop",
    "user:create": "tsx scripts/create-user.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "backup:local": "tsx scripts/backup-local.ts",
    "format": "prettier --write src scripts tests *.ts *.json *.mjs *.yml docs README.md"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.0",
    "@zip.js/zip.js": "^2.24.0",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "nuqs": "^2.10.2",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.0",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "read-excel-file": "^9.3.14",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "@prisma/client@7.10.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "sharp@0.35.5": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true
  }
}
